# Copia este archivo a .env y llena los valores de tu proyecto de Supabase.
# Settings -> API en el panel de Supabase.
#
# Sin estas variables QuickView arranca igual, con datos de demostracion,
# para que puedas ver la app funcionando antes de conectar nada.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
